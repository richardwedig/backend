# Copy this file to .env and fill it in.

# Turns on the AI Helper. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: require a password to open the website (strongly recommended
# if the website is on the internet).
APP_PASSWORD=

# Optional: where your data and files are kept (default: ./data)
# DATA_DIR=/var/lib/work-tracker

# Optional: port number (default 3000)
# PORT=3000
